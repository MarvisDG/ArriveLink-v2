# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker (matches docker-compose.yml defaults):
DATABASE_URL=postgres://arrivelink:arrivelink@localhost:5432/arrivelink
#
# Neon (cloud). Free tier, Postgres 17, scales to zero. Keep ?sslmode=require —
# the pool enables TLS based on its presence.
# DATABASE_URL=postgres://<user>:<password>@<endpoint>.neon.tech/arrivelink?sslmode=require
DATABASE_POOL_MAX=10

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate real ones: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated.
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# ── Booking windows (PRD §5) ──────────────────────────────────────────────────
RESPONSE_WINDOW_MINUTES=10
PAYMENT_WINDOW_MINUTES=25
SETTLEMENT_WINDOW_HOURS=24
SWEEPER_INTERVAL_SECONDS=30

# ── Fees (PRD §8) ─────────────────────────────────────────────────────────────
# Fixed NGN 200, in kobo. Identical across payment methods.
CONVENIENCE_FEE_KOBO=20000

# ── Third parties (optional in development) ───────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
RESEND_API_KEY=
EMAIL_FROM=ArriveLink <no-reply@arrivelink.ng>
